# .env.example
VITE_API_URL=

# Google Sign-In — OAuth 2.0 Web Client ID from Google Cloud Console.
# Not secret; GoogleSignInButton renders nothing at all if this is unset.
VITE_GOOGLE_CLIENT_ID=

# Apple Sign-In — the web "Services ID" (not the app Bundle ID) and its
# registered HTTPS redirect URI from the Apple Developer portal. Apple
# does not allow http://localhost redirect URIs — local testing needs an
# HTTPS tunnel (e.g. ngrok) or a staging deployment. AppleSignInButton
# renders nothing at all if either of these is unset.
VITE_APPLE_SERVICES_ID=
VITE_APPLE_REDIRECT_URI=
